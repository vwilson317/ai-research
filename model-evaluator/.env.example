# Copy to .env and fill in what you have. Keys can also be pasted in the UI (API keys page).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Default key for OpenAI-compatible endpoints (OpenRouter, Groq, Together...)
OPENROUTER_API_KEY=

# Docker only: host folder with your voice-note transcripts (the audio-transcriber's iCloud output)
VOICE_NOTES_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/Transcripts
