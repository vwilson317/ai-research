# Local development (`npm run dev`). On Netlify, set these under Site configuration → Environment variables.

# Required when deployed: the password for the app's login screen.
APP_PASSWORD=
# Optional: separate secret for signing sessions and encrypting stored API keys (defaults to APP_PASSWORD).
APP_SECRET=

# Provider keys (or paste them on the app's API keys page; they're stored encrypted).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Database: Netlify DB sets NETLIFY_DATABASE_URL automatically. Any Neon Postgres URL also works.
# Leave empty locally to use an embedded Postgres stored in .data/
DATABASE_URL=
